# Supabase Configuration for Setlla Realtime Sync (setlla.com)
# Get these keys from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudinary CDN Configuration for Property Videos & Photo Optimization
# Get these from Cloudinary Dashboard -> Settings -> Upload -> Upload presets (Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Paystack Payment Gateway for Ad Campaigns & Brand Sponsorships
# Get your Public Key from Paystack Dashboard -> Settings -> API Keys & Webhooks
# Use pk_test_... for test mode or pk_live_... for real collections
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

